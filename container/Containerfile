FROM docker.io/library/fedora:44

RUN dnf -y install java-25-openjdk-headless nodejs npm git curl which \
 && dnf clean all

# ffmpeg with libx264 (host ffmpeg lacks it; RPM Fusion's build has it)
RUN dnf -y install https://mirrors.rpmfusion.org/free/fedora/rpmfusion-free-release-$(rpm -E %fedora).noarch.rpm \
 && dnf -y install ffmpeg \
 && dnf clean all \
 && ffmpeg -hide_banner -encoders 2>/dev/null | grep -q libx264

RUN curl -fsSL https://download.clojure.org/install/linux-install-1.12.0.1527.sh | bash

WORKDIR /app
COPY deps.edn shadow-cljs.edn package.json ./
RUN clojure -P -M:dev:test

COPY . .
RUN npm install --no-audit --no-fund
RUN npx shadow-cljs release client
RUN clojure -M:dev -e '(require (quote goob-toob.core)) (println "clj compile OK")'

EXPOSE 8080
CMD ["clojure", "-M:dev", "-m", "goob-toob.core"]
