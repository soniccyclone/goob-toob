{:paths ["src/clj" "src/cljc" "resources"]
 :license {:name "AGPL-3.0-or-later"
           :url "https://www.gnu.org/licenses/agpl-3.0.html"}
 :deps
 {org.clojure/clojure              {:mvn/version "1.12.0"}
  org.clojure/core.async           {:mvn/version "1.9.865"}
  org.clojure/data.json            {:mvn/version "2.5.0"}
  cheshire/cheshire                {:mvn/version "5.13.0"}
  ring/ring                        {:mvn/version "1.15.5"}
  ring/ring-json                   {:mvn/version "0.5.1"}
  metosin/reitit-ring              {:mvn/version "0.7.2"}
  org.ring-clojure/ring-websocket-async {:mvn/version "0.2.0"}
  com.github.seancorfield/next.jdbc {:mvn/version "1.3.1118"}
  org.xerial/sqlite-jdbc           {:mvn/version "3.46.1.0"}}
 :aliases
 {:dev  {:extra-paths ["dev"]}
  :test {:extra-paths ["test/clj"]
         :extra-deps  {io.github.cognitect-labs/test-runner
                       {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts   ["-m" "cognitect.test-runner" "-d" "test/clj"]}
  :run  {:main-opts ["-m" "goob-toob.core"]}}}
