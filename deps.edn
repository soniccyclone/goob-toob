{:paths ["src/clj" "src/cljc" "resources"]
 :deps
 {org.clojure/clojure              {:mvn/version "1.12.0"}
  org.clojure/core.async           {:mvn/version "1.7.601"}
  org.clojure/data.json            {:mvn/version "2.5.0"}
  cheshire                         {:mvn/version "5.13.0"}
  ring/ring                        {:mvn/version "1.13.0"}
  ring-multipart/ring-multipart    {:mvn/version "0.3.1"}
  metosin/reitit-ring              {:mvn/version "0.7.2"}
  ring-websocket/ring-websocket    {:mvn/version "0.4.2"}
  next.jdbc                        {:mvn/version "1.3.946"}
  org.xerial/sqlite-jdbc           {:mvn/version "3.46.1.0"}}
 :aliases
 {:dev  {:extra-paths ["dev"]}
  :test {:extra-paths ["test"]
         :extra-deps  {io.github.cognitect-labs/test-runner
                       {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts   ["-m" "cognitect.test-runner" "-d" "test/clj"]}
  :run  {:main-opts ["-m" "goob-toob.core"]}}}
